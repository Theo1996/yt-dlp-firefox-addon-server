{
  "manifest_version": 2,
  "name": "YT Downloader",
  "version": "0.14.1",
  "permissions": [
    "tabs",
    "activeTab",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://raw.githubusercontent.com/*",
    "notifications",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "theonipponotaku@hotmail.com",
      "strict_min_version": "92.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Download with yt-dlp"
  }
}